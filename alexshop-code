type Product = { id: string; name: string; unit: string; price: number; emoji: string; tint: string };
type Store = { id: string; name: string; category: string; emoji: string; tint: string; eta: string; minOrder: number; products: Product[] };
type Cart = Record<string, number>;
type View =
    | { kind: 'home' }
    | { kind: 'store'; storeId: string }
    | { kind: 'cart' }
    | { kind: 'checkout' }
    | { kind: 'done'; order: Order };
type Order = { number: string; total: number; items: number; address: string; payment: string };

