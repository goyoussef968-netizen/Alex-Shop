const productIndex = new Map<string, { store: Store; product: Product }>();
for (const store of stores) for (const product of store.products) productIndex.set(`${store.id}:${product.id}`, { store, product });

const egp = (n: number) => `${n} ج.م`;

function QtyStepper({ qty, onChange }: { qty: number; onChange: (qty: number) => void }) {
    return <div className="alex-stepper" dir="ltr">
        <button type="button" aria-label="قلل الكمية" onClick={() => onChange(qty - 1)}>{qty <= 1 ? '🗑' : '−'}</button>
        <span aria-live="polite">{qty}</span>
        <button type="button" aria-label="زود الكمية" onClick={() => onChange(qty + 1)}>+</button>
    </div>;
}

export function App() {
    const [view, setView] = useState<View>({ kind: 'home' });
    const [cart, setCart, saved] = useLocalState<Cart>('alexshop-cart.v1', {});
    const [name, setName] = useState('');
    const [phone, setPhone] = useState('');
    const [address, setAddress] = useState('');
    const [payment, setPayment] = useState('cash');
    const [triedSubmit, setTriedSubmit] = useState(false);

    const entries = useMemo(() => Object.entries(cart)
        .map(([key, qty]) => ({ key, qty, item: productIndex.get(key)! }))
        .filter((entry) => entry.item && entry.qty > 0), [cart]);
    const itemCount = entries.reduce((sum, entry) => sum + entry.qty, 0);
    const subtotal = entries.reduce((sum, entry) => sum + entry.qty * entry.item.product.price, 0);
    const total = subtotal + (entries.length ? DELIVERY_FEE : 0);

    const setQty = (key: string, qty: number) => {
        if (!saved.ready) return;
        const next = { ...cart };
        if (qty <= 0) delete next[key]; else next[key] = qty;
        setCart(next);
    };

    const confirmOrder = () => {
        setTriedSubmit(true);
        if (!name.trim() || !phone.trim() || !address.trim() || entries.length === 0) return;
        const order: Order = {
            number: `AX-${String(Math.floor(1000 + Math.random() * 9000))}`,
            total, items: itemCount, address: address.trim(),
            payment: payment === 'cash' ? 'كاش عند الاستلام' : 'فودافون كاش',
        };
        setCart({});
        setTriedSubmit(false);
        setView({ kind: 'done', order });
    };

    const cartBar = entries.length > 0 && view.kind !== 'cart' && view.kind !== 'checkout' && view.kind !== 'done'
        ? <div className="alex-cartbar">
            <div>
                <strong>السلة: <bdi>{`${itemCount} ${itemCount === 1 ? 'منتج' : 'منتجات'}`}</bdi></strong>
                <span className="alex-cartbar-total"><bdi>{egp(subtotal)}</bdi></span>
            </div>
            <FileButton variant="primary" compact onClick={() => setView({ kind: 'cart' })}>عرض السلة</FileButton>
        </div>
        : null;

    return <FileCard lang="ar" dir="rtl">
        <Header
            title="Alex shop"
            fact="العجمي، إسكندرية"
            intro="نسخة تجريبية من تطبيق العميل: تتصفح المحلات، تضيف للسلة، وتأكد الطلب. جرّبها براحتك."
        />

        {view.kind === 'home' && <>
            <Callout title="بيانات تجريبية" tone="note">
                المحلات والمنتجات والأسعار هنا للتجربة بس، ومش محلات حقيقية ولا طلب حقيقي بيتبعت.
            </Callout>
            <Photos label="Alex shop" items={[{ src: preview, alt: 'رسم توضيحي لشنطة مشتريات فيها عيش وخضار وفاكهة' }]} />
            <Caption>رسم توضيحي، مش صورة منتجات حقيقية.</Caption>
            <Group label="المحلات" heading>
                <div className="alex-stores">
                    {stores.map((store) => <button key={store.id} type="button" className="alex-store" onClick={() => setView({ kind: 'store', storeId: store.id })}>
                        <span className="alex-well" style={{ background: store.tint }} aria-hidden>{store.emoji}</span>
                        <span className="alex-store-body">
                            <strong className="file-hover-underline">{store.name}</strong>
                            <span>{store.category}</span>
                            <span>التوصيل {store.eta} • أقل طلب <bdi>{egp(store.minOrder)}</bdi></span>
                        </span>
                        <span className="alex-chevron" aria-hidden>‹</span>
                    </button>)}
                </div>
            </Group>
            <Group label="إزاي بيشتغل" heading>
                <NumberedList items={[
                    'تختار المحل اللي هتطلب منه.',
                    'تضيف المنتجات للسلة وتظبط الكميات.',
                    'تكتب اسمك وعنوانك وتأكد الطلب.',
                    'السائق يستلم الطلب ويوصله لحد باب البيت.',
                ]} />
            </Group>
        </>}

        {view.kind === 'store' && (() => {
            const store = stores.find((s) => s.id === (view as { storeId: string }).storeId)!;
            return <>
                <FileButton variant="ghost" compact onClick={() => setView({ kind: 'home' })}>‹ رجوع للمحلات</FileButton>
                <Group label={store.category} heading={store.name}>
                    <Caption>التوصيل {store.eta} • أقل طلب <bdi>{egp(store.minOrder)}</bdi> • الأسعار تجريبية</Caption>
                    <div className="alex-grid">
                        {store.products.map((product) => {
                            const key = `${store.id}:${product.id}`;
                            const qty = cart[key] ?? 0;
                            return <div key={product.id} className="alex-product">
                                <span className="alex-well alex-well-lg" style={{ background: product.tint }} aria-hidden>{product.emoji}</span>
                                <strong>{product.name}</strong>
                                <span className="alex-unit">{product.unit}</span>
                                <div className="alex-buy">
                                    <span className="alex-price"><bdi>{egp(product.price)}</bdi></span>
                                    {qty === 0
                                        ? <FileButton variant="secondary" compact pill onClick={() => setQty(key, 1)}>أضف</FileButton>
                                        : <QtyStepper qty={qty} onChange={(q) => setQty(key, q)} />}
                                </div>
                            </div>;
                        })}
                    </div>
                </Group>
            </>;
        })()}

        {view.kind === 'cart' && <>
            <FileButton variant="ghost" compact onClick={() => setView({ kind: 'home' })}>‹ أكمل التسوق</FileButton>
            <Group label="سلة المشتريات" heading>
                {entries.length === 0
                    ? <Callout title="السلة فاضية" tone="note">ضيف منتجات من أي محل وارجع هنا.</Callout>
                    : <>
                        <div className="alex-cart">
                            {entries.map(({ key, qty, item }) => <div key={key} className="alex-cartrow">
                                <span className="alex-well" style={{ background: item.product.tint }} aria-hidden>{item.product.emoji}</span>
                                <span className="alex-cartrow-body">
                                    <strong>{item.product.name}</strong>
                                    <span>{item.store.name} • {item.product.unit}</span>
                                </span>
                                <QtyStepper qty={qty} onChange={(q) => setQty(key, q)} />
                                <span className="alex-price"><bdi>{egp(qty * item.product.price)}</bdi></span>
                            </div>)}
                        </div>
                        <Facts items={[
                            { label: 'المنتجات', value: egp(subtotal) },
                            { label: 'التوصيل', value: egp(DELIVERY_FEE) },
                            { label: 'الإجمالي', value: egp(total) },
                        ]} />
                        <div className="alex-actions">
                            <FileButton variant="primary" onClick={() => setView({ kind: 'checkout' })}>متابعة للدفع</FileButton>
                            <FileButton variant="ghost" onClick={() => setCart({})}>فضّي السلة</FileButton>
                        </div>
                    </>}
            </Group>
        </>}

        {view.kind === 'checkout' && <>
            <FileButton variant="ghost" compact onClick={() => setView({ kind: 'cart' })}>‹ رجوع للسلة</FileButton>
            <Group label="بيانات التوصيل" heading>
                <TextField label="الاسم" value={name} onChange={setName} />
                <TextField label="رقم الموبايل" value={phone} onChange={setPhone} />
                <TextField label="العنوان بالتفصيل (العجمي)" value={address} onChange={setAddress} />
                {triedSubmit && (!name.trim() || !phone.trim() || !address.trim()) &&
                    <p className="alex-error" role="alert">املأ الاسم ورقم الموبايل والعنوان قبل تأكيد الطلب.</p>}
            </Group>
            <Group label="طريقة الدفع" heading>
                <ChoiceRow
                    label="الدفع"
                    options={[
                        { value: 'cash', label: 'كاش عند الاستلام' },
                        { value: 'wallet', label: 'فودافون كاش' },
                    ]}
                    value={payment}
                    onChange={setPayment}
                />
            </Group>
            <Group label="ملخص الطلب" heading>
                <Facts items={[
                    { label: 'عدد المنتجات', value: String(itemCount) },
                    { label: 'المنتجات', value: egp(subtotal) },
                    { label: 'التوصيل', value: egp(DELIVERY_FEE) },
                    { label: 'الإجمالي', value: egp(total) },
                ]} />
                <div className="alex-actions">
                    <FileButton variant="primary" onClick={confirmOrder}>تأكيد الطلب</FileButton>
                </div>
                <Caption>{saved.message}</Caption>
            </Group>
        </>}

        {view.kind === 'done' && (() => {
            const order = (view as { order: Order }).order;
            return <>
                <Group label="تم استلام الطلب" heading>
                    <div className="alex-done">
                        <span className="alex-done-icon" aria-hidden>✅</span>
                        <p><strong>طلبك اتسجل برقم <bdi>{order.number}</bdi></strong></p>
                        <p>هيوصلك على عنوان: {order.address} خلال ٤٥ لـ ٦٠ دقيقة تقريبًا.</p>
                    </div>
                    <Facts items={[
                        { label: 'عدد المنتجات', value: String(order.items) },
                        { label: 'الإجمالي شامل التوصيل', value: egp(order.total) },
                        { label: 'الدفع', value: order.payment },
                    ]} />
                    <Callout title="ده طلب تجريبي" tone="warning">مفيش طلب حقيقي اتبعت ولا فلوس اتدفعت. في التطبيق الحقيقي هنا بيتم إشعار المحل وتعيين سائق.</Callout>
                    <div className="alex-actions">
                        <FileButton variant="primary" onClick={() => setView({ kind: 'home' })}>اطلب من جديد</FileButton>
                    </div>
                </Group>
            </>;
        })()}

        {cartBar}

        <Closing>نسخة تجريبية للعرض بس، ببيانات وأسعار غير حقيقية. آخر تحديث ٢٦ نوفمبر ٢٠٢٦.</Closing>
    </FileCard>;
}

