html, body, #root { margin: 0; min-height: 100%; }
body { background: var(--ds-page); }
.file-nav { display: flex; flex-wrap: wrap; gap: 20px; border-bottom: 1px solid var(--ds-hairline); }
.file-nav a { padding: 10px 0; color: var(--ds-ink-2); text-decoration: none; }
.file-nav a[aria-current="page"] { color: var(--ds-ink); box-shadow: inset 0 -1px 0 var(--ds-ink); }
@media (max-width: 600px) { .file-nav a { display: inline-flex; align-items: center; min-height: 44px; } }

/* Alex shop prototype */

.alex-stores { display: grid; gap: 12px; }
.alex-store {
    display: flex; align-items: center; gap: 14px; text-align: start;
    padding: 12px; border: 1px solid var(--ds-hairline); border-radius: 16px;
    background: var(--ds-page); color: var(--ds-ink); cursor: pointer; font: inherit;
    min-height: 44px;
}
.alex-store:hover { border-color: var(--ds-teal); }
.alex-store-body { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
.alex-store-body strong { font-weight: 600; }
.alex-store-body span { color: var(--ds-ink-2); font-size: 12px; line-height: 18px; }
.alex-chevron { color: var(--ds-ink-2); font-size: 22px; line-height: 1; }
.alex-well {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border-radius: 12px; font-size: 26px; flex: none;
}
.alex-well-lg { width: 100%; height: 84px; border-radius: 12px; font-size: 40px; }

.alex-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 12px; }
@media (min-width: 768px) { .alex-grid { grid-template-columns: repeat(3, 1fr); } }
.alex-product {
    display: flex; flex-direction: column; gap: 6px;
    padding: 12px; border: 1px solid var(--ds-hairline); border-radius: 16px;
}
.alex-product strong { font-weight: 600; }
.alex-unit { color: var(--ds-ink-2); font-size: 12px; }
.alex-buy { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 4px; }
.alex-price { font-weight: 600; color: var(--ds-teal); white-space: nowrap; }

.alex-stepper {
    display: inline-flex; align-items: center; gap: 2px;
    border: 1px solid var(--ds-hairline); border-radius: 999px; padding: 2px;
}
.alex-stepper button {
    width: 32px; height: 32px; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--ds-raised); color: var(--ds-ink); font-size: 16px; line-height: 1;
}
.alex-stepper span { min-width: 24px; text-align: center; font-weight: 600; }

.alex-cart { display: flex; flex-direction: column; }
.alex-cartrow {
    display: flex; align-items: center; gap: 12px; padding: 12px 0;
    border-bottom: 1px solid var(--ds-hairline); flex-wrap: wrap;
}
.alex-cartrow-body { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 120px; }
.alex-cartrow-body strong { font-weight: 600; }
.alex-cartrow-body span { color: var(--ds-ink-2); font-size: 12px; }

.alex-cartbar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    margin-top: 24px; padding: 12px 16px; border-radius: 16px;
    background: var(--ds-raised);
}
.alex-cartbar-total { color: var(--ds-ink-2); margin-inline-start: 10px; }

.alex-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
.alex-error { color: var(--ds-red); margin: 8px 0 0; }

.alex-done { text-align: center; padding: 12px 0 4px; }
.alex-done-icon { font-size: 44px; display: block; margin-bottom: 8px; }

